# Copiar a .env (local) y configurar las mismas variables en Vercel. Nunca versionar valores reales.

# --- Servidor (funciones de api/): NUNCA con prefijo VITE_, quedaría en el bundle público ---

# Clave de la API de Gemini. Rotar la clave anterior (estuvo como VITE_GEMINI_API_KEY en el bundle público).
GEMINI_API_KEY=

# Modelo (opcional). Por defecto gemini-3.5-flash-lite.
GEMINI_MODEL=

# Tope global de llamadas al modelo por día UTC (opcional). Por defecto 500.
GEMINI_DAILY_CAP=

# Orígenes permitidos para llamar a /api/chat, separados por comas (opcional).
# Por defecto https://rvargas.dev y https://www.rvargas.dev; fuera de producción también localhost y 127.0.0.1.
# Origin/Referer solo frenan sitios de terceros en navegadores; el control real es el límite de tasa.
# En preview también se aceptan localhost y 127.0.0.1 (VERCEL_ENV != production): usar en Preview una
# GEMINI_API_KEY distinta con cuota baja y/o activar Deployment Protection en los previews.

# Control real contra abuso (externo, fuera del código): regla de rate limit en el Firewall de Vercel sobre
# POST /api/chat y cuota/presupuesto máximo en Google AI Studio / Cloud. El límite en memoria del código es
# por instancia de la función y se reinicia en cada cold start: es solo una primera barrera.
ALLOWED_ORIGINS=

# --- Cliente (públicas por diseño de EmailJS) ---
# Plantilla de EmailJS (el destino NO se envía desde el cliente):
#   To Email = soporte@rvdesk.app (fijo) | Reply-To = {{reply_to}} | Subject = {{subject}} | From Name = {{from_name}}
#   Cuerpo = {{name}}, {{email}}, {{phone}}, {{message}}, {{source}} (doble llave, escapado). Sin auto-respuesta.
#   Panel: dominios permitidos y límites de uso. RVDesk: el remitente conectado al servicio debe ser contacto
#   verificado del workspace o el correo cae en cuarentena para triage manual.
VITE_EMAIL_USER_ID=
VITE_EMAIL_SERVICE_ID=
VITE_EMAIL_TEMPLATE_ID=
