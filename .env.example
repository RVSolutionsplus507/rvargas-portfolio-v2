# Copiar a .env (local). En Cloudflare Pages: Settings > Variables and Secrets, en Production y en Preview.
# Nunca versionar valores reales.

# --- Servidor (functions/ y api/_lib/): NUNCA con prefijo VITE_, quedaría en el bundle público ---

# Clave de la API de Gemini. Rotar la clave anterior (estuvo como VITE_GEMINI_API_KEY en el bundle público).
# En Cloudflare, tipo "Secret" (cifrado). Usar en Preview una clave distinta con cuota baja.
GEMINI_API_KEY=

# Modelo (opcional). Por defecto gemini-3.5-flash-lite.
GEMINI_MODEL=

# Tope de llamadas al modelo por día UTC (opcional). Por defecto 500. Es por isolate de Cloudflare, no global:
# el tope real es la cuota/presupuesto en Google AI Studio / Cloud.
GEMINI_DAILY_CAP=

# Orígenes extra permitidos para llamar a /api/chat, separados por comas (opcional).
# Siempre se acepta el propio origen de la petición (rvargas.dev, *.pages.dev, localhost en dev).
# Vacío: https://rvargas.dev y https://www.rvargas.dev.
# Origin/Referer solo frenan sitios de terceros en navegadores; el control real es el límite de tasa:
# regla de Rate Limiting/WAF de Cloudflare sobre POST /api/chat (el límite en memoria es por isolate).
ALLOWED_ORIGINS=

# Hostnames que pueden usar /api/chat, separados por comas (opcional). Falla cerrado: vacío = rvargas.dev,
# www.rvargas.dev, localhost, 127.0.0.1 y [::1]. Production no necesita definirlo (o rvargas.dev,www.rvargas.dev);
# así *.pages.dev queda cerrado, pues ahí NO aplica la regla WAF/Rate Limiting (solo cubre el dominio propio).
# Preview DEBE usar ALLOWED_HOSTS=* para probar el chat. Un dominio propio nuevo (IDN en punycode, xn--...) debe agregarse a la lista.
ALLOWED_HOSTS=

# --- Cliente (públicas por diseño de EmailJS; en Cloudflare se usan en el build) ---
# Plantilla de EmailJS (el destino NO se envía desde el cliente):
#   To Email = soporte@rvdesk.app (fijo) | Reply-To = {{reply_to}} | Subject = {{subject}} | From Name = {{from_name}}
#   Cuerpo = {{name}}, {{email}}, {{phone}}, {{message}}, {{source}} (doble llave, escapado). Sin auto-respuesta.
#   Panel: dominios permitidos y límites de uso. RVDesk: el remitente conectado al servicio debe ser contacto
#   verificado del workspace o el correo cae en cuarentena para triage manual.
VITE_EMAIL_USER_ID=
VITE_EMAIL_SERVICE_ID=
VITE_EMAIL_TEMPLATE_ID=
